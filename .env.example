BOT_TOKEN=telegram-bot-token
VK_TOKEN=vk-bot-token
ADMIN_CHAT_ID=123456789

DB_HOST=postgres-host
DB_NAME=worktimebot
DB_USER=worktimebot
DB_PASSWORD=change-me
DB_PORT=5432

API_KEY=change-me-worktime-api-key

GOOGLE_SHEETS_SPREADSHEET_ID=spreadsheet-id
GOOGLE_SHEETS_CURRENT_SHEET=current_month
GOOGLE_SHEETS_RATES_SHEET=Rates
GOOGLE_SHEETS_BONUSES_SHEET=Bonuses
GOOGLE_SHEETS_PENALTIES_SHEET=Penalties
GOOGLE_SHEETS_PROJECTS_SHEET=Projects
GOOGLE_SERVICE_ACCOUNT_FILE=/app/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local development: set both flags to false if the real bots are already running on the server.
# Production/server: set the required bot flags to true.
ENABLE_TELEGRAM_BOT=false
ENABLE_VK_BOT=false

STANDFLOW_API_BASE_URL=http://host.docker.internal:8001
STANDFLOW_BOT_API_TOKEN=change-me-shared-work-time-token
